<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OndeEstouApp.Views.LocalPage"
             xmlns:vm="clr-namespace:OndeEstouApp.ViewModel"
             x:DataType="vm:LocalViewModel"
             Title="LocalPage">
             
             <ScrollView>
                  <VerticalStackLayout>
        <Label 
            Text="📍 Minha Localização" />
    <Button Command="{Binding GetLocationCommand}"
           Text="Onde estou?"/>

    <Label Text="Rua"/>
    <Entry Text="{Binding CurrentLocation.Thoroughfare}"/>

            <Label Text="Rua"/>
            <Entry Text="{Binding CurrentLocation.Thoroughfare}"/>


            <Label Text="Número"/>
            <Entry Text="{Binding CurrentLocation.FeatureName}"/>

            <Label Text="Bairro"/>
            <Entry Text="{Binding CurrentLocation.SubLocality}"/>

        </VerticalStackLayout>
             </ScrollView>
   
</ContentPage>